# Signing secret from your webhook endpoint (Developers > Webhooks), starts with whsec_
STRIPE_WEBHOOK_SECRET=
# Optional. Not needed: the listener makes no Stripe API calls.
STRIPE_API_KEY=
PORT=4242
SIGNALS_FILE=signals.csv
# Event IDs already processed, so Stripe's retries are ignored across restarts
STATE_FILE=processed_events.txt
